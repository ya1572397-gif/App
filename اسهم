            const plans = [
                { name: "مجاني", price: 0, features: ["5 تنبيهات/يوم", "لوحة أساسية", "نظرة عامة للسوق", "مجتمع المستخدمين"], color: "#64748b" },
                { name: "احترافي", price: 49, features: ["تنبيهات غير محدودة", "محلل ذكاء اصطناعي", "تقارير PDF", "قوائم مراقبة", "دعم أولوية"], color: "#06b6d4", popular: true },
