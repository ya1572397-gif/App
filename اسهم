        const WATCHLIST = ["تسلا", "إنفيديا", "أرامكو", "آبل"];

        const AI_RESPONSES = {
            default: `## تحليل شامل للمشهد الاستثماري\n\nأقوم بتحليل السياق الكامل للسوق، وتدفقات الأموال الذكية، والمؤشرات الفنية لتزويدك برؤى استثمارية بمستوى المؤسسات المالية. اسألني عن أي سهم، أو ظروف السوق، أو استراتيجية تداول.`,
            aramco: `## أرامكو السعودية (2222.SR) — تحليل مؤسسي متقدم\n\n**إشارة الأموال الذكية: تراكم قوي جداً**\n\nتم رصد ارتفاع في حجم التداول بمقدار **5.3 ضعف** المتوسط خلال 20 يوماً. ضغط الشراء المؤسسي مؤكد بمؤشر LPI 5/5.\n\n**الرؤية الفنية:**\n- RSI: 68 (يقترب من ذروة الشراء لكن مع زخم إيجابي)\n- MACD: تقاطع صاعد مؤكد\n- EMA: السعر فوق جميع المتوسطات 20/50/200 — توافق كامل للاتجاه الصاعد\n\n**توقعات الذكاء الاصطناعي:**\n- 24 ساعة: ↑ احتمال صعود 84%\n- 7 أيام: ↑ احتمال صعود 79%\n- 30 يوم: ↑ احتمال صعود 72%\n\n**الإجراء: شراء قوي** | المخاطرة: منخفضة\n\nمنطقة الدخول: 28.50 – 28.80 ريال\nالهدف الأول: 30.20 ريال (+5.0%)\nالهدف الثاني: 32.00 ريال (+11.3%)`,
            apple: `## آبل (AAPL) — تحليل مؤسسي متقدم\n\n**إشارة الأموال الذكية: تراكم**\n\nارتفاع حجم التداول **4.1x** مع وجود نشاط ملحوظ للحيتان في دفتر أوامر الخيارات.\n\n**الرؤية الفنية:**\n- RSI: 62 (زخم صحي وليس في ذروة)\n- MACD: صاعد مع توسع في الرسم البياني\n- السعر فوق متوسطي 20/50 — إيجابي في الأجل القصير والمتوسط\n\n**توقعات الذكاء الاصطناعي:**\n- 24 ساعة: ↑ احتمال صعود 78%\n- 7 أيام: ↑ احتمال صعود 72%\n- 30 يوم: ↑ احتمال صعود 65%\n\n**الإجراء: شراء** | المخاطرة: منخفضة\n\nمنطقة الدخول: $210 – $215`,
            tesla: `## تسلا (TSLA) — تحليل مؤسسي متقدم\n\n**إشارة الأموال الذكية: تراكم قوي جداً**\n\nارتفاع هائل في حجم التداول **6.7x** مع وجود أوامر تغذية سريعة من المؤسسات. هذه واحدة من أقوى الإعدادات الحالية.\n\n**الرؤية الفنية:**\n- RSI: 71 (زخم قوي مع احتمالية تصحيح)\n- MACD: تقاطع صاعد قوي\n- السعر فوق جميع المتوسطات المتحركة\n\n**توقعات الذكاء الاصطناعي:**\n- 24 ساعة: ↑ احتمال صعود 89%\n- 7 أيام: ↑ احتمال صعود 82%\n- 30 يوم: ↑ احتمال صعود 74%\n\n**الإجراء: شراء قوي** | المخاطرة: متوسطة (تقلبات عالية)`,
        };

        // ─── دوال مساعدة محسنة ─────────────────────────────────────────────────────────
        const getActionColor = (action) => {
            if (action === "شراء قوي") return "#10b981";
            if (action === "شراء") return "#06b6d4";
            if (action === "بيع قوي") return "#ef4444";
            if (action === "بيع") return "#f97316";
            return "#94a3b8";
        };

        const getRiskColor = (risk) => {
            if (risk === "منخفض") return "#10b981";
            if (risk === "متوسط") return "#f59e0b";
            return "#ef4444";
        };

        const getLpiDots = (lpi) => Array.from({ length: 5 }, (_, i) => i < lpi);
        const formatCurrency = (val, currency) => currency === "USD" ? `$${val.toLocaleString()}` : `${val.toLocaleString()} ريال`;
        const getMarketFlag = (market) => (market === "SA" ? "🇸🇦" : "🇺🇸");

        // ─── رسوم بيانية بسيطة ──────────────────────────────────────────────────────────────
        function Sparkline({ positive, width = 80, height = 30 }) {
            const pts = Array.from({ length: 12 }, (_, i) => {
                const noise = (Math.random() - 0.5) * 8;
                const trend = positive ? i * 1.5 : -i * 1.5;
                return Math.max(2, Math.min(28, 15 + trend + noise));
            });
            const max = Math.max(...pts), min = Math.min(...pts);
            const norm = pts.map(p => ((p - min) / (max - min)) * (height - 4) + 2);
            const path = norm.map((y, i) => `${i === 0 ? "M" : "L"} ${(i / 11) * (width - 4) + 2} ${height - y}`).join(" ");
            const fill = norm.map((y, i) => `${(i / 11) * (width - 4) + 2},${height - y}`).join(" ");
            const color = positive ? "#10b981" : "#ef4444";
            return (
                <svg width={width} height={height} style={{ overflow: "visible" }}>
                    <defs><linearGradient id={`sg-${positive}`} x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stopColor={color} stopOpacity="0.3" /><stop offset="100%" stopColor={color} stopOpacity="0" /></linearGradient></defs>
                    <polygon points={`2,${height} ${fill} ${width - 2},${height}`} fill={`url(#sg-${positive})`} />
                    <path d={path} fill="none" stroke={color} strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" />
                </svg>
            );
        }

        function ConfidenceRing({ value, size = 56 }) {
            const r = (size - 8) / 2;
            const circ = 2 * Math.PI * r;
            const dash = (value / 100) * circ;
            const color = value >= 85 ? "#10b981" : value >= 70 ? "#06b6d4" : "#f59e0b";
            return (
                <div style={{ position: "relative", width: size, height: size }}>
                    <svg width={size} height={size} style={{ transform: "rotate(-90deg)" }}>
                        <circle cx={size/2} cy={size/2} r={r} fill="none" stroke="#1a1a1a" strokeWidth="5" />
                        <circle cx={size/2} cy={size/2} r={r} fill="none" stroke={color} strokeWidth="5" strokeDasharray={`${dash} ${circ}`} strokeLinecap="round" style={{ transition: "stroke-dasharray 0.8s ease" }} />
                    </svg>
                    <div style={{ position: "absolute", inset: 0, display: "flex", alignItems: "center", justifyContent: "center", flexDirection: "column" }}>
                        <span style={{ fontSize: 12, fontWeight: 700, color, fontFamily: "'Cairo', sans-serif" }}>{value}</span>
                    </div>
                </div>
            );
        }

        function AnimatedCounter({ value, prefix = "", suffix = "", decimals = 0 }) {
            const [display, setDisplay] = useState(0);
            useEffect(() => {
                let start = 0, end = value, dur = 1200, startTime = null;
                const step = (ts) => {
                    if (!startTime) startTime = ts;
                    const prog = Math.min((ts - startTime) / dur, 1);
                    const ease = 1 - Math.pow(1 - prog, 3);
                    setDisplay(+(start + ease * (end - start)).toFixed(decimals));
                    if (prog < 1) requestAnimationFrame(step);
                };
                requestAnimationFrame(step);
            }, [value]);
            return <span>{prefix}{display.toLocaleString()}{suffix}</span>;
        }

        function PulseDot({ color = "#10b981" }) {
            return (
                <span style={{ position: "relative", display: "inline-flex", width: 8, height: 8 }}>
                    <span style={{ position: "absolute", inset: 0, borderRadius: "50%", background: color, opacity: 0.4, animation: "ping 1.5s cubic-bezier(0,0,0.2,1) infinite" }} />
                    <span style={{ borderRadius: "50%", width: 8, height: 8, background: color }} />
                </span>
            );
        }

        // ─── صفحة الهبوط (باللون الأسود والأبيض الكريمي) ────────────────────────────────────
        function LandingPage({ onEnter }) {
            const [tick, setTick] = useState(0);
            useEffect(() => { const t = setInterval(() => setTick(p => p + 1), 3000); return () => clearInterval(t); }, []);
            const stats = [
                { label: "الإشارات النشطة", value: "2,847", change: "+12%" },
                { label: "دقة التوقعات", value: "91.4%", change: "+2.1%" },
                { label: "متوسط العائد", value: "18.7%", change: "+4.3%" },
