            ];
            return (
                <div style={{ minHeight: "100vh", background: "#000000", color: "#f5f0e8", fontFamily: "'Cairo', sans-serif", overflowX: "hidden" }}>
                    {/* شريط الأسعار المتحرك */}
                    <div style={{ background: "#0a0a0a", borderBottom: "1px solid #1f1f1f", padding: "8px 0", fontSize: 12, fontFamily: "'Cairo', monospace", overflow: "hidden", whiteSpace: "nowrap" }}>
                        <div style={{ display: "inline-block", animation: "ticker 30s linear infinite" }}>
                            {[...SIGNALS, ...SIGNALS].map((s, i) => (
                                <span key={i} style={{ marginRight: 40, color: s.change > 0 ? "#10b981" : "#ef4444" }}>
                                    {getMarketFlag(s.market)} {s.symbol} {formatCurrency(s.price, s.currency)} {s.change > 0 ? "▲" : "▼"}{Math.abs(s.change)}%
                                </span>
