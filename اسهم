                            </div>
                        ))}
                    </div>

                    {/* معاينة الإشارات */}
                    <div style={{ padding: "0 24px", marginBottom: 60 }}>
                        <h2 style={{ fontSize: 28, fontWeight: 800, marginBottom: 8 }}>الإشارات المباشرة</h2>
                        <p style={{ color: "#666", marginBottom: 24, fontSize: 14 }}>إشارات لحظية من محرك الأموال الذكية</p>
                        <div style={{ display: "grid", gridTemplateColumns: "repeat(auto-fill, minmax(280px, 1fr))", gap: 12 }}>
                            {SIGNALS.slice(0, 4).map(s => (
                                <div key={s.id} style={{ background: "#0a0a0a", border: "1px solid #1f1f1f", borderRadius: 12, padding: 16 }}>
                                    <div style={{ display: "flex", justifyContent: "space-between", marginBottom: 12 }}>
                                        <div><span style={{ fontSize: 10 }}>{getMarketFlag(s.market)}</span><span style={{ fontWeight: 700, fontSize: 16, marginLeft: 6 }}>{s.symbol}</span><div style={{ fontSize: 18, fontWeight: 800, marginTop: 4 }}>{formatCurrency(s.price, s.currency)}</div></div>
                                        <span style={{ background: getActionColor(s.action) + "20", color: getActionColor(s.action), padding: "4px 10px", borderRadius: 6, fontSize: 11, fontWeight: 700 }}>{s.action}</span>
                                    </div>
                                    <div style={{ display: "flex", gap: 16, fontSize: 11, color: "#666" }}><span>الحجم: <span style={{ color: "#f59e0b" }}>{s.volumeSpike}x</span></span><span>الثقة: <span style={{ color: s.confidence>=85?"#10b981":"#06b6d4" }}>{s.confidence}%</span></span><span>المخاطرة: <span style={{ color: getRiskColor(s.risk) }}>{s.risk}</span></span></div>
                                </div>
                            ))}
                        </div>
                    </div>

                    {/* الباقات */}
                    <div style={{ padding: "0 24px 60px" }}>
                        <h2 style={{ fontSize: 28, fontWeight: 800, textAlign: "center", marginBottom: 8 }}>اختر مستواك</h2>
                        <p style={{ color: "#666", textAlign: "center", marginBottom: 32 }}>ابدأ مجاناً وارتقِ عندما تصبح جاهزاً</p>
                        <div style={{ display: "grid", gridTemplateColumns: "repeat(auto-fit, minmax(260px, 1fr))", gap: 20, maxWidth: 900, margin: "0 auto" }}>
