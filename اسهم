                        </p>
                        <div className="fade-up-3" style={{ display: "flex", gap: 16, justifyContent: "center", flexWrap: "wrap" }}>
                            <button onClick={onEnter} style={{ background: "linear-gradient(135deg,#06b6d4,#0284c7)", border: "none", color: "#fff", padding: "14px 32px", borderRadius: 10, fontWeight: 700, fontSize: 16, cursor: "pointer" }}>جرب مجاناً ←</button>
                            <button onClick={onEnter} style={{ background: "transparent", border: "1px solid #333", color: "#a0a0a0", padding: "14px 32px", borderRadius: 10, fontWeight: 600, fontSize: 16, cursor: "pointer" }}>عرض تجريبي</button>
                        </div>
                    </div>

                    {/* إحصائيات */}
                    <div style={{ display: "grid", gridTemplateColumns: "repeat(4, 1fr)", gap: 1, background: "#1f1f1f", margin: "0 24px", borderRadius: 12, overflow: "hidden", marginBottom: 60 }}>
                        {stats.map((s, i) => (
                            <div key={i} style={{ background: "#0a0a0a", padding: "24px 16px", textAlign: "center" }}>
                                <div style={{ fontSize: 24, fontWeight: 800, fontFamily: "'Cairo', monospace", color: "#f5f0e8" }}>{s.value}</div>
                                <div style={{ fontSize: 12, color: "#666", marginTop: 4 }}>{s.label}</div>
