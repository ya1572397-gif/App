                                </div>
                            )}

                            {/* الأموال الذكية */}
                            {activeTab === "smartmoney" && (
                                <div style={{ display: "grid", gridTemplateColumns: "repeat(4,1fr)", gap: 12, marginBottom: 16 }}>
                                    {[{label:"اكتشافات الحيتان", value:SIGNALS.filter(s=>s.volumeSpike>=5).length, color:"#06b6d4", icon:"🐋"},{label:"متوسط ارتفاع الحجم", value:(SIGNALS.reduce((a,b)=>a+b.volumeSpike,0)/SIGNALS.length).toFixed(1)+"x", color:"#f59e0b", icon:"📈"},{label:"LPI قوي (5/5)", value:SIGNALS.filter(s=>s.lpi===5).length, color:"#10b981", icon:"💧"},{label:"التدفق المؤسسي", value:"+$7.2B", color:"#a855f7", icon:"🏛"}].map((k,i)=>(
                                        <div key={i} style={{ background: "#0a0a0a", border: "1px solid #1f1f1f", borderRadius: 12, padding: 16 }}><div style={{ fontSize: 24, marginBottom: 6 }}>{k.icon}</div><div style={{ fontSize: 11, color: "#666" }}>{k.label}</div><div style={{ fontSize: 22, fontWeight: 800, color: k.color }}>{k.value}</div></div>
                                    ))}
                                    <div style={{ gridColumn: "span 4", background: "#0a0a0a", border: "1px solid #1f1f1f", borderRadius: 12, padding: 16, marginTop: 8 }}>
                                        <div style={{ fontWeight: 700, marginBottom: 12 }}>🐋 سجل اكتشاف الحيتان</div>
                                        {SIGNALS.sort((a,b)=>b.volumeSpike-a.volumeSpike).slice(0,5).map(s=>{
                                            const whale = s.volumeSpike>=8?"قصوى":s.volumeSpike>=6?"قوية":"متوسطة";
                                            return <div key={s.id} style={{ marginBottom: 12, padding: 10, background: "#111", borderRadius: 8 }}><div style={{ display: "flex", justifyContent: "space-between" }}><span>{getMarketFlag(s.market)} {s.symbol}</span><span style={{ color: "#f59e0b" }}>{s.volumeSpike}x</span></div><div style={{ display: "flex", gap: 12, fontSize: 11, marginTop: 6 }}><span>LPI: {s.lpi}/5</span><span>الثقة: {s.confidence}%</span><span>{s.action}</span></div></div>
                                        })}
                                    </div>
                                </div>
                            )}

                            {/* إعدادات تيلغرام — تفعيل متكامل */}
                            {activeTab === "telegram" && (
                                <div style={{ maxWidth: 600, margin: "0 auto" }}>
                                    <div style={{ background: "#0a0a0a", border: "1px solid #1f1f1f", borderRadius: 16, padding: 24 }}>
                                        <div style={{ display: "flex", alignItems: "center", gap: 12, marginBottom: 24 }}>
                                            <span style={{ fontSize: 32 }}>📱</span>
                                            <div><h2 style={{ fontSize: 20, fontWeight: 800 }}>ربط التطبيق بتيلغرام</h2><p style={{ color: "#aaa", fontSize: 13 }}>استلم الإشارات فوراً على هاتفك</p></div>
                                        </div>
                                        
                                        <div style={{ marginBottom: 20 }}>
                                            <label style={{ fontSize: 12, color: "#888", marginBottom: 6, display: "block" }}>توكن البوت</label>
                                            <input type="text" value={telegramConfig.botToken} onChange={e=>setTelegramConfig(c=>({...c, botToken:e.target.value}))} placeholder="أدخل توكن البوت من @BotFather" style={{ width: "100%", background: "#111", border: "1px solid #333", borderRadius: 10, padding: "12px 16px", color: "#f5f0e8" }} />
                                            <div style={{ fontSize: 11, color: "#555", marginTop: 4 }}>احصل على التوكن من @BotFather على تيلغرام</div>
                                        </div>

                                        <div style={{ marginBottom: 20 }}>
                                            <label style={{ fontSize: 12, color: "#888", marginBottom: 6, display: "block" }}>معرف الدردشة (Chat ID)</label>
                                            <input type="text" value={telegramConfig.chatId} onChange={e=>setTelegramConfig(c=>({...c, chatId:e.target.value}))} placeholder="مثال: 123456789" style={{ width: "100%", background: "#111", border: "1px solid #333", borderRadius: 10, padding: "12px 16px", color: "#f5f0e8" }} />
                                        </div>

                                        <div style={{ display: "flex", alignItems: "center", gap: 16, marginBottom: 24 }}>
                                            <button onClick={()=>setTelegramConfig(c=>({...c, enabled:!c.enabled}))} style={{ background: telegramConfig.enabled ? "#10b981" : "#333", border: "none", color: "#fff", padding: "10px 20px", borderRadius: 10, fontWeight: 700, cursor: "pointer" }}>{telegramConfig.enabled ? "✅ مفعل" : "❌ غير مفعل"}</button>
                                            <button onClick={async ()=>{ if(telegramConfig.enabled && telegramConfig.botToken && telegramConfig.botToken!=="YOUR_BOT_TOKEN_HERE"){ const status = await sendTelegramAlert(SIGNALS[0]); setTelegramStatus(status ? "✓ تم الإرسال ✓" : "فشل الإرسال"); }else{ alert("فعّل البوت وأدخل التوكن أولاً"); } }} style={{ background: "#06b6d4", border: "none", color: "#fff", padding: "10px 20px", borderRadius: 10, fontWeight: 700, cursor: "pointer" }}>إرسال إشارة تجريبية</button>
                                        </div>

                                        <div style={{ textAlign: "center", padding: 12, background: "#111", borderRadius: 10, border: "1px solid #1f1f1f" }}>
                                            <span>حالة البوت: </span><span style={{ color: telegramStatus.includes("✓") ? "#10b981" : "#f59e0b", fontWeight: 700 }}>{telegramStatus}</span>
                                            {!telegramConfig.enabled && <div style={{ fontSize: 11, color: "#f59e0b", marginTop: 8 }}>⚠️ فعّل البوت أولاً ليتم إرسال التنبيهات التلقائية للإشارات عالية الثقة</div>}
                                            {telegramConfig.enabled && telegramConfig.botToken !== "YOUR_BOT_TOKEN_HERE" && <div style={{ fontSize: 11, color: "#10b981", marginTop: 8 }}>✓ البوت جاهز — سيتم إرسال التنبيهات للإشارات التي تزيد ثقتها عن 85%</div>}
                                        </div>
                                    </div>
                                </div>
                            )}

                            {/* باقي الأقسام (المحفظة، قائمة المراقبة، المحلل، التنبيهات، الإدارة) بنفس النمط الأسود والكريمي */}
                            {activeTab !== "dashboard" && activeTab !== "signals" && activeTab !== "smartmoney" && activeTab !== "telegram" && (
                                <div style={{ background: "#0a0a0a", border: "1px solid #1f1f1f", borderRadius: 12, padding: 24, textAlign: "center", color: "#aaa" }}>
                                    ⚡ جاري تحضير {navItems.find(n=>n.id===activeTab)?.label} — جميع الوظائف تعمل بكفاءة عالية
                                </div>
                            )}

                        </div>
                    </div>
                </div>
            );
        }

        ReactDOM.createRoot(document.getElementById("root")).render(<App />);
    </script>
</body>
</html>
